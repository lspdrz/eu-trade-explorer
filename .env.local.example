# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this example file is the only one that should be committed.

# Local dev: run `docker compose up -d` (see docker-compose.yml), then use
# the connection string below as-is — matches that file's credentials.
# Production (Vercel): use a Neon connection string instead (Neon Console ->
# Connect, or via the Vercel/Neon Marketplace integration). Same schema,
# different connection string per environment — nothing else changes.
DATABASE_URL="postgresql://eu_trade_explorer:local_dev_only@localhost:5432/eu_trade_explorer"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# triggers /api/fertilizer-sync. Any long random string; must match what's
# set in the Vercel project's environment variables in production. Used
# locally too, to manually trigger a sync during development.
CRON_SECRET="generate-a-long-random-string"
