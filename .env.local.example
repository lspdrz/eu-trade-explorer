# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this example file is the only one that should be committed.

# Local dev: run `docker compose up -d` (see docker-compose.yml), then use
# the connection string below as-is — matches that file's credentials.
# Production (Vercel): use a Neon connection string instead (Neon Console ->
# Connect). Use the POOLED endpoint (host ends in `-pooler`) — lib/db/client.ts
# runs `max: 1` per instance and relies on Neon's pooler for concurrency.
# Put the Neon project and the Vercel functions in the same region (us-east).
# Same schema, different connection string per environment.
#
# The sync scripts (scripts/sync-agrifood.ts, scripts/sync-comext.ts, each
# with a --backfill flag) are run locally against production by pointing
# this at the Neon connection string — use the DIRECT (non-pooler) host for
# those, they open one long transaction. See scripts/ and app/api/*/route.ts.
DATABASE_URL="postgresql://eu_trade_explorer:local_dev_only@localhost:5432/eu_trade_explorer"

# Shared secret for the sync route handlers (Authorization: Bearer <value>).
# Any long random string. Set the same value in the Vercel project's env
# vars. Used locally to trigger a sync by hand during development. (Vercel
# Cron is not currently enabled — see app/api/fertilizer-sync/route.ts.)
CRON_SECRET="generate-a-long-random-string"
